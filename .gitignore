# Secrets & vault
.vault.key
nexus.vault
.nexus-setup-token
.env
.env.local

# Brain Organizer config -- vault_path/logs_folder/processed_file are
# environment-specific absolute paths (found during the Linux port: this file
# being tracked meant every `git pull` silently reset the LXC's paths back
# to Windows's, breaking the Brain MCP server until manually re-patched).
# Untracked here so each environment keeps its own local copy across pulls
# -- the version already on disk in each checkout (Windows or LXC) is
# unaffected by this change, only future tracking is.
modules/brain-organizer/config.json

# UniFi TLS certificate pin store (TOFU known_hosts, host-specific -- not portable across machines/deployments)
.unifi_known_hosts.json

# Unraid TLS certificate pin store (TOFU known_hosts, host-specific -- not portable across machines/deployments)
.unraid_known_hosts.json

# Unraid SSH host-key store for the native docker-prune path (TOFU known_hosts, host-specific -- not portable across machines/deployments)
.unraid_ssh_known_hosts

# Local backups — contain secrets (.vault.key, nexus.vault); NEVER commit
backups/

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
# The digest relay's own venv (tools/relay_claude_digest.py, run from cron on
# devbox). Untracked AND unignored, it was silently destroyed by a routine
# `git clean -fd` during the 2026-08-15 branch switch, which broke the daily
# digest delivery with only a "python: not found" line in the cron log.
.relay-venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
nexus.db
nexus.db-wal
nexus.db-shm
nexus.db.bak*

# Frontend build & deps
frontend/node_modules/
frontend/dist/

# Logs & runtime
logs/
*.log
*.db

# OS
.DS_Store
Thumbs.db

# Claude Code session directory -- but skills are real reusable content, not
# ephemeral session state, so track those.
# `.claude/*` and NOT `.claude/`: git never descends into an excluded
# DIRECTORY, so the negations below are inert against `.claude/` and every
# skill had to be `git add -f`'d by hand (which is how the first four got in,
# and why the next two nearly didn't). Excluding the contents instead lets the
# re-includes actually work.
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/hooks/
!.claude/hooks/**

# Local-only relay bookkeeping (not synced across machines)
digests/claude-features/.relay_state.json
