# Secrets & vault
.vault.key
nexus.vault
.nexus-setup-token
.env
.env.local
.nexus.pids

# Brain Organizer config -- vault_path/logs_folder/processed_file are
# environment-specific absolute paths (found during the Linux port: this file
# being tracked meant every `git pull` silently reset the LXC's paths back
# to Windows's, breaking the Brain MCP server until manually re-patched).
# Untracked here so each environment keeps its own local copy across pulls
# -- the version already on disk in each checkout (Windows or LXC) is
# unaffected by this change, only future tracking is.
modules/brain-organizer/config.json

# UniFi TLS certificate pin store (TOFU known_hosts, host-specific -- not portable across machines/deployments)
.unifi_known_hosts.json

# Unraid TLS certificate pin store (TOFU known_hosts, host-specific -- not portable across machines/deployments)
.unraid_known_hosts.json

# Unraid SSH host-key store for the native docker-prune path (TOFU known_hosts, host-specific -- not portable across machines/deployments)
.unraid_ssh_known_hosts

# LXC SSH host-key store for the native /restart lxc path (TOFU known_hosts, host-specific -- not portable across machines/deployments)
.lxc_ssh_known_hosts

# Local backups — contain secrets (.vault.key, nexus.vault); NEVER commit
backups/

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
nexus.db
nexus.db-wal
nexus.db-shm
nexus.db.bak*

# Frontend build & deps
frontend/node_modules/
frontend/dist/

# Logs & runtime
logs/
*.log
*.db

# OS
.DS_Store
Thumbs.db

# Claude Code session directory
.claude/

# Local-only relay bookkeeping (not synced across machines)
digests/claude-features/.relay_state.json
